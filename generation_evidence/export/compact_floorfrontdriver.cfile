open d3plot "d3plot"

genselect target part
genselect target node
genselect node add part 2000394/0

ntime 5
xyplot 1 savefile curve_file "results_compact\x_displacement" 1 all
ntime 6
xyplot 1 savefile curve_file "results_compact\y_displacement" 1 all
ntime 7
xyplot 1 savefile curve_file "results_compact\z_displacement" 1 all

genselect target part
genselect target element
genselect element add part 2000394/0

etime 9
xyplot 1 savefile curve_file "results_compact\effective_stress" 1 all
etime 7
xyplot 1 savefile curve_file "results_compact\effective_plastic_strain" 1 all

exit
